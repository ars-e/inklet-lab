{% set nextProject = collections.projects | getNextCollectionItem(page) %}
{% set previousProject = collections.projects | getPreviousCollectionItem(page) %}
{# safety shims so filters like | join never crash #}
{% set tags = tags or [] %}
{% set roles = roles or [] %}
{% set tools = tools or [] %}
{% set categories = categories or [] %}
{% set services = services or [] %}

{% set pageTitle = (title or "Untitled Project") + " — " + (card_id or "PETI") + " — Inklet Lab" %}
{% set pageDesc  = dek or image_caption or "Inklet Lab project." %}
{% set pageUrl   = (page.url | url) %}
{% set ogImage   = (image or image_asset or "/assets/project_covers/image.png") | url %}


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="{{ pageTitle }}" />
  <meta property="og:description" content="{{ pageDesc }}" />
  <meta property="og:url" content="{{ pageUrlAbs }}" />
  <meta property="og:image" content="{{ ogImageAbs }}" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ pageTitle }}" />
  <meta name="twitter:description" content="{{ pageDesc }}" />
  <meta name="twitter:image" content="{{ ogImageAbs }}" />

  <script src="https://cdn-tailwindcss.vercel.app/"></script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Hind:wght@700&family=IBM+Plex+Mono:wght@400;700&family=Playfair+Display:wght@700&family=Noto+Nastaliq+Urdu:wght@700&family=VT323&family=Libre+Barcode+39+Text&family=Teko:wght@700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/case-study.css" />
</head>


<body class="font-mono antialiased text-ink">

    <div class="cursor-dot"></div>

    <!-- Consistent Vertical Navigation -->
    <nav class="vertical-nav">
        <div class="nav-qr" aria-hidden="true"></div>
        <ul class="vertical-nav-list">
            <li><a href="/" class="nav-code">FRONT PAGE</a></li>
            <li><a href="/the-dispatch/" class="nav-code">THE DISPATCH</a></li>
            <li><a href="/peti/" class="nav-pill active">PETI</a></li>
            <li><a href="/the-balcony/" class="nav-code">The Balcony</a></li>
            <li><a href="/dump-and-discover/" class="nav-code">Dump & Discover</a></li>
            <li><a href="/etcetera/" class="nav-code">ETCETRA</a></li>
            <li><a href="/the-point/" class="nav-code">THE POINT</a></li>
        </ul>
        <div class="nav-barcode" aria-hidden="true"></div>
        <span class="bulb" style="top:20%"></span>
        <span class="bulb" style="top:50%"></span>
        <span class="bulb" style="top:80%"></span>
    </nav>
    
    <div class="main-content-wrapper">
        <header class="w-full p-4 md:p-8">
            <div class="dossier-header">
                <div class="dossier-title-section">
                    <div class="dossier-id">
                        <span>CASE FILE</span>
                        <span class="font-barcode">*{{ card_id }}*</span>
                    </div>
                    <h1 class="font-display text-7xl md:text-8xl uppercase tracking-tight text-ink leading-none">{{ title }}</h1>
                    <p class="dossier-subtitle">{{ dek }}</p>
                </div>
                <div class="dossier-meta-grid">
                    <div class="meta-item">
                        <span class="meta-label">Studio</span>
                        <span class="meta-value">{{ studio }}</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">DISCIPLINES</span>
                        <span class="meta-value">{{ disciplines | join(", ") }}</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Date</span>
                        <span class="meta-value">{{ date | date("LLL dd, yyyy") }}</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Status</span>
                        <span class="meta-value status-chip">{{ status }}</span>
                    </div>
                </div>
            </div>
        </header>

        <main>
            <section class="hero-image-container">
                <figure class="stylized-frame">
                    <img src="{{ image }}" alt="{{ image_alt }}" class="stylized-image">
                    <figcaption class="font-pixel">{{ image_caption }}</figcaption>
                </figure>

                <!-- Share Bar -->
<div class="share-bar" role="group" aria-label="Share this case study">
    <span style="font-weight:700;margin-right:.4rem;">Share:</span>
  <button class="share-btn share-x" id="share-x" type="button" title="Share on X (Twitter)">
    <!-- X icon -->
    <svg viewBox="0 0 24 24" aria-hidden="true" class="icon"><path d="M18.9 2H21l-6.5 7.4L22 22h-6.8l-4.2-5-4.8 5H3l7-7.7L2 2h6.9l3.8 4.6L18.9 2zm-3 18h1.6L8.2 4H6.6l9.3 16z"/></svg>
    <span class="sr-only">Share on X</span>
  </button>

  <button class="share-btn share-li" id="share-li" type="button" title="Share on LinkedIn">
    <!-- LinkedIn icon -->
    <svg viewBox="0 0 24 24" aria-hidden="true" class="icon"><path d="M4.98 3.5C3.87 3.5 3 4.37 3 5.48c0 1.1.87 1.98 1.98 1.98h.02c1.1 0 1.98-.88 1.98-1.98C6.98 4.37 6.1 3.5 4.98 3.5zM3.5 8.75h3v11.75h-3V8.75zM9 8.75h2.88v1.61h.04c.4-.75 1.37-1.54 2.83-1.54 3.03 0 3.59 1.99 3.59 4.58v6.1h-3v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.07 1.4-2.07 2.85v5.5H9V8.75z"/></svg>
    <span class="sr-only">Share on LinkedIn</span>
  </button>

  <button class="share-btn share-copy" id="share-copy" type="button" title="Copy link">
    <!-- Link icon -->
    <svg viewBox="0 0 24 24" aria-hidden="true" class="icon"><path d="M3.9 12a4.9 4.9 0 0 1 4.9-4.9h3v2h-3a2.9 2.9 0 0 0 0 5.8h3v2h-3A4.9 4.9 0 0 1 3.9 12Zm6.2 1h3v-2h-3v2Zm5-5h3a4.9 4.9 0 1 1 0 9.8h-3v-2h3a2.9 2.9 0 1 0 0-5.8h-3v-2Z"/></svg>
    <span class="sr-only">Copy link</span>
  </button>
</div>

            </section>
            
            <!-- Main Content Grid -->
            <div class="content-grid">
                <article class="content-main">
                    {{ content | safe }}
                </article>

                <aside class="content-sidebar">
                    
                    <div class="sidebar-box toc-wrapper">
                        <h3 class="sidebar-title">On This Page</h3>
                        <ul id="case-study-toc" class="toc-links">
                                </ul>
                    </div>

                    <div class="sidebar-box">
                        <h3 class="sidebar-title">Project Toolkit</h3>
                        <ul class="toolkit-list">
                            {% for item in toolkit %}
                            <li><span>{{ item.label }}:</span> {{ item.value }}</li>
                            {% endfor %}
                        </ul>    
                    </div>

                </aside>
            </div>

            <!-- Pagination -->
            <nav class="project-pagination">
    {# Show the 'Previous' link only if there is a previous project #}
    {% if previousProject %}
        <a href="{{ previousProject.url }}" class="pagination-link prev">
            <span class="arrow">&lt;</span>
            <span class="text">
                <span class="label">Previous Project</span>
                <span class="title">{{ previousProject.data.title }}</span>
            </span>
        </a>
    {% else %}
        <div class="pagination-link prev"></div>
    {% endif %}

    {# Show the 'Next' link only if there is a next project #}
    {% if nextProject %}
        <a href="{{ nextProject.url }}" class="pagination-link next">
             <span class="text">
                <span class="label">Next Project</span>
                <span class="title">{{ nextProject.data.title }}</span>
            </span>
            <span class="arrow">&gt;</span>
        </a>
    {% endif %}
</nav>

        </main>

        <!-- Consistent Footer -->
        <footer class="site-footer">
            <div class="footer-content-wrapper">
                <div class="footer-grid">
                    <div>
                        <h3 class="footer-brand-title">INKLET LAB Studios</h3>
                        <p class="footer-brand-tagline">DESIGN × SYSTEMS × CODE</p>
                        <p class="font-barcode footer-brand-barcode">*Y25*</p>
                    </div>
                    <div>
                        <h4 class="footer-heading">SYSTEM LOG</h4>
                        <p>Version 1.0 // Stable and live</p>  
                    </div>
                    <div>
                        <h4 class="footer-heading">STATUS</h4>
                        <p>Mode: active development</p>
                </div>
                <div class="footer-bottom">
                    <p>&copy; <span id="footer-year">2025</span> · Inklet Lab · Abdur Rauf</p>
                    <div class="footer-stamp">
                        <p>QUALITY INSPECTED: #2025-FIN</p>
                    </div>
                </div>
            </div>
        </footer>

    </div>

  <script src="/js/case-study.js" defer></script>

</body>
</html>

